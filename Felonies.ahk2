; match := arrayOfFelonMaps[arrayOfFelonMapsI].get(currentMapI) ; probably gets the value, which is the person's age?
; if (match) { duplicateFelonMap[ ; need to figure out what happens when iterating a map.

For (i, fileName in selectedFiles) {
    fileExt := ""
    ageRegEx := ""
    SplitPath fileName,,,&fileExt
    if (StrLower(fileExt) == "csv") {
        csvFile := selectedFiles.RemoveAt(i)
        Continue
    }
    tempFelonMap := Map() ; declaring a Map (only allows unique entries)
    textContent := FileRead(fileName)
    textContent := RegExReplace(textContent, "i)" . regExRepStr)
    textContent := StrReplace(textContent, "Name: ", "¢") ; Replace "Name: " with a dummy character not found in file
    Loop parse, textContent, "¢" { ; Loop through each felon text file, splitting at dummy character
        if (StrLen(A_LoopField) && InStr(A_LoopField, "Felon")) { ; if string has length, and "Felon" is found in the string
            ageYears := "", generationalName := "" ; declare age, generationalName as string
            ageFound := RegExMatch(A_LoopField, "i)Age: (?<digits>\d+)", &ageYears) ; find and store age to ageYears
            ageYears := ageFound ? ageYears.digits : "??" ; set default value for ageYears if needed
            trimStr := RegExReplace(A_LoopField, "(?:\r\n|\r|\n).*") ; discard everything after the name line (should be first line)
            ; genNameFound := RegExMatch(A_LoopField, "i)\b(JR|SR|II|III)\b", &generationalName)
            ; trimStr := RegExReplace(trimStr, "i), (JR|SR|II|III)", " $1") ; standardize generational names by removing the comma between name and JR/SR/II/III
            trimStr := StrUpper(Trim(StrReplace(trimStr, ", ", ","))) ; change comma space in name to comma to match MAXIS, sets to uppercase
            trimStr := RegExReplace(trimStr, " .*") ; removes everything after LastName,FirstName
            trimStr := RegExReplace(StrUpper(trimStr), ", (\w+) .*", "$1") ; change comma space in name to comma to match MAXIS, sets to uppercase, removes everything after LastName,FirstName
            ageList := tempFelonMap.Get(trimStr, "") ; check tempFelonMap for the name, store resulting age or ""
            if (StrLen(ageList) && ageYears ~= ageList) { ; if ageYears is found in string ageList...
                Continue ; ...go to next entry
            }
            tempFelonMap.Set(trimStr, Trim(ageList "," ageYears, ",")) ; else add person + trimmed ageList to Map
        }
    }
    arrayOfFelonMaps.Push(tempFelonMap)
}
