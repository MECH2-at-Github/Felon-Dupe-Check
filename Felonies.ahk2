felonFileObj.write("Duplicate felon List, generated: " dateYmd "`n`n" felonDuplicatesString)

if (csvFile.Length == 0) {
    felonFileObj.close()
    openPrompt := MsgBox("Felon list generated. MAXIS list not provided.`n`nOpen " felonFileName " now?", "Felon List", "YesNo")
    ; openPrompt := MsgBox("Felon list generated. MAXIS list not provided.`n`nOpen " outputFolder "\Duplicate felon list " . dateYmd . ".txt now?", "Felon List", "YesNo")
    if (openPrompt == "Yes") {
        Run(felonFileName)
    }
    ExitApp
}

;csvText := FileRead(csvFile[1])
;Loop parse, csvText, "`n" {
Loop parse, FileRead(csvFile), "`n" {
    nameMatch := []
    nameInField := RegExMatch(A_LoopField, '".+"', &nameMatch)
    if (!nameInField) {
        continue
    }
    personName := Trim(nameMatch[], '"') ; remove quotes
    personName := Trim(personName) ; remove outide whitespace
    personName := RegExReplace(personName, "\s\w\b") ; remove space + standalone letter (typically middle initial)
    ; personName := RegExReplace(personName, "\b\w\b") ; remove standalone letter (typically middle initial)
    csvPersonArray.Push(Trim(personName))
}

confidenceLookup := Map(
    "High", "",
    "Low", ","
)

For key, confidenceLevel in ["High", "Medium", "Low"] {
    ; FindDuplicatesTruncated(confidenceLevel, felonDuplicatesArray, csvPersonArray)
}

;FindDuplicatesTruncated(confidenceLevel, Arrays*) { ; PROBLEM: What if person appears on list twice? Should felon array be mapped, and MAXIS array be compared?
FindDuplicatesTruncated(confidenceLevel, felonDuplicatesArray, csvPersonArray) { ; PROBLEM: What if person appears on list twice? Should felon array be mapped, and MAXIS array be compared? Doesn't seem to be enough MAXIS data to do a confidence level, aside from LastnameF
    SplitChar := confidenceLookup[confidenceLevel]
    Counts := Map() ; create object named Counts
    Duplicates := [] ; create simple array named Duplicates
    Arrays := [] ; temp declaration to make the linter happy
    for (Arr in Arrays) { ; in each array
    
        for (Person in Arr) { ; for each Person ; PROBLEM: Should all 3 confidence levels be done at once? Start at Low; if match, add to lowConfidence array and move to Medium?
            Person := SubStr(Trim(Person), 1, 20) ; remove spaces around name & make felon list names no longer than MAXIS names.
            Person := StrLen(SplitChar) ? StrSplit(Person, SplitChar) : Person
            Counts[Person] := (Counts.Has(Person) ? Counts[Person] + 1 : 1) ; if Person doesn't already exist, set it's value to 1. Otherwise, add 1. 
            if (Counts[Person] == 2) { ; if the value of the Person is now 2...
                Duplicates.Push(Person) ; add it to the duplicate array.
            }
        }
    }
    felonFileObj.write(separatorLine "`nConfidence level: " confidenceLevel "`n" objToString(Duplicates))
}

felonFileObj.close()

openPrompt := MsgBox("Felon list generated and compared to MAXIS list.`n`nOpen " felonFileName " now?", "Felon List", "YesNo")
; openPrompt := MsgBox("Felon list generated and compared to MAXIS list.`n`nOpen " outputFolder "\Duplicate felon list " . dateYmd . ".txt now?", "Felon List", "YesNo")
if (openPrompt == "Yes") {
    Run(felonFileName)
}
ExitApp

Return














