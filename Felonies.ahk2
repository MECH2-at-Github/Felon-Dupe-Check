objToString(object, includeKey := true, includeValue := true) { ; AHK arrays are also objects ; temporary function to get feedback
    For key, value in object {
        output .= (includeKey ? key : '') (includeKey && includeValue ? " = " : '') (includeValue ? value : '') "`n"
    }
    Return Trim(output, "`n")
}
mapToString(object) {
    output := ""
    For (value in object) {
        output .= value "`n"
    }
    Return Trim(output, "`n")
}
FindDuplicateFelons(Arrays*) { ; PROBLEM: What if person appears on list twice? Should array 1 be mapped, and array 2 be compared?
    Counts := Map() ; create object named Counts
    felonMap := Map()
    Duplicates := [] ; create simple array named Duplicates
    for (Arr in Arrays) { ; in each array
        for (Person in Arr) { ; for each Person
            Person := Trim(Person) ; remove spaces around name
            Counts[Person] := (Counts.Has(Person) ? Counts[Person] + 1 : 1) ; if Person doesn't already exist, set it's value to 1. Otherwise, add 1. 
            if (Counts[Person] == 2) { ; if the value of the Person is now 2...
                felonMap[Person] := 1 ; add it to the duplicate array.
                ;Duplicates.Push(Person) ; add it to the duplicate array.
            }
        }
    }
    return felonMap
    ;return Duplicates
}
;felonDuplicatesArray := FindDuplicateFelons(felonArray)
felonDuplicatesMap := FindDuplicateFelons(felonArray)
;felonDuplicatesString := objToString(felonDuplicatesArray)
felonDuplicatesString := objToString(felonDuplicatesMap)

