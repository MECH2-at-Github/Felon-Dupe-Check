}

;; Declaring Global variables
regExEnd := ".*(?:\r\n|\r|\n)*|", regExRepStr := ""
arrayOfFelonMaps := [], felonArray := [], csvPersonArray := [], csvFile := []
dateYmd := FormatTime(, "yyyy-M-d")
felonFileName := outputFolder "\Duplicate felon list " . dateYmd . ".txt"
separatorLine := "`n`n=======================================================================================`n", cs := ", "
;;

For (removalString in regExRemovals) { ; simulating JS' .join('|')
    regExRepStr .= removalString . regExEnd ; adding 'end of line' and pipe separator
}
regExRepStr := RTrim(regExRepStr, "|") ; removes pipe separator after the last entry

; selectedFiles := FileSelect("M3",, "Select TEXT files containing the felon lists, and (optionally) a CSV file of the MAXIS list.")
